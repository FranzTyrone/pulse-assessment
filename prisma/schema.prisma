generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id       String   @id
  token     String
  lat      Float
  lng      Float
  busy     Boolean  @default(false)
  lastSeen DateTime

  @@index([lastSeen])
}

model Signal {
  id        String   @id @default(uuid())
  toId      String
  fromId    String
  type      String
  payload   String?
  createdAt DateTime @default(now())

  @@index([toId])
}
